{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "myous",
  "version": "../package.json",
  "identifier": "com.myoushq.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeBuildCommand": "npm run build:ui",
    "beforeDevCommand": "npm run build:ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "myous",
        "url": "index.html",
        "width": 640,
        "height": 700,
        "minWidth": 560,
        "minHeight": 480,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "nsis"],
    "category": "Utility",
    "externalBin": ["binaries/myous-worker"],
    "shortDescription": "Your agents' worker on this computer",
    "longDescription": "myous is the human's side of a worker: it runs the worker container, pairs it with your agent and shows every request the agent makes.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    },
    "linux": {
      "appimage": { "bundleMediaFramework": false }
    }
  }
}
